import {
    integer,
    jsonb,
    pgTable,
    serial,
    text,
    varchar,
} from "drizzle-orm/pg-core";

export const freelanceWorkSchema = pgTable("freelance_works", {
    id: serial("id").primaryKey(),
    slug: varchar("slug", { length: 255 }).notNull().unique(),
    name: varchar("name", { length: 255 }).notNull(),
    year: varchar("year", { length: 255 }).notNull(),
    client: varchar("client", { length: 255 }).notNull(),
    category: varchar("category", { length: 255 }).notNull(),
    gradient: varchar("gradient", { length: 255 }).notNull(),
    tags: jsonb("tags").notNull(),
    image: varchar("image", { length: 255 }).notNull(),
    brandBg: varchar("brand_bg", { length: 255 }).notNull(),
    brandChar: varchar("brand_char", { length: 10 }).notNull(),
    overview: jsonb("overview").notNull(),
    description: jsonb("description").notNull(),
    scope: jsonb("scope").notNull(),
    discoverUrl: varchar("discover_url", { length: 255 }),
    order: integer("order").notNull().default(0),
});
