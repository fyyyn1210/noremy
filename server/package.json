{
  "name": "server",
  "version": "1.0.50",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "hash": "bun .scripts/hash-password.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:seed": "bun .scripts/seed.ts",
    "db:generate": "drizzle-kit generate --config=src/configs/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/configs/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/configs/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/configs/drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/static": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "elysia": "latest",
    "envalid": "^8.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11"
  },
  "module": "src/index.js"
}
